VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Comma-separated list of Google account emails allowed to manage the ad
# whitelist from the in-app admin panel. This only gates the UI — you must
# also restrict writes to the `adWhitelist` Firestore collection to these
# same accounts via security rules.
VITE_ADMIN_EMAILS=

# ── Netlify function env vars (server-only — set these in the Netlify site's
# environment variables, not in the client build; do NOT prefix with VITE_) ──
# Stripe secret key for your account/mode (test or live).
STRIPE_SECRET_KEY=
# Signing secret from the Stripe webhook endpoint (dashboard.stripe.com/webhooks).
STRIPE_WEBHOOK_SECRET=
# Price ID for the "Remove Ads" product. Create it by running:
#   STRIPE_SECRET_KEY=sk_test_... node scripts/create-remove-ads-product.mjs
STRIPE_PRICE_ID=
# Shared secret for the RevenueCat webhook that mirrors Play Store purchases
# into Firestore (so ad removal bought in the Android app also applies on the
# web). Invent any long random string and paste the SAME value into RevenueCat →
# Project settings → Integrations → Webhooks → Authorization header.
REVENUECAT_WEBHOOK_SECRET=
# Entitlement identifier the webhook treats as ad removal. Must be the SAME
# value as VITE_REVENUECAT_ENTITLEMENT below — if they diverge, the webhook
# ignores the events the client's purchases generate and a Play purchase never
# becomes ad-free on the web.
REVENUECAT_ENTITLEMENT=cocktail_flashcards_pro
# Firebase Admin service account (Firebase Console → Project settings →
# Service accounts → Generate new private key). Keep the \n escapes as-is.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Native mobile (Capacitor / Play Store) build — see
# docs/mobile-monetization.md. Client-inlined, so prefix with VITE_.
# IMPORTANT: the Capacitor app loads the DEPLOYED site, so the values that reach
# Play users come from the NETLIFY build. Set these in the Netlify site's
# environment variables too — setting them only here affects `npm run dev`. ──
# AdMob banner ad unit id. Leave blank to serve Google's TEST banner.
VITE_ADMOB_BANNER_ID=
# RevenueCat PRODUCTION public Android SDK key, starts with goog_ (RevenueCat
# dashboard → API keys). Required before shipping to Play.
VITE_REVENUECAT_ANDROID_KEY=
# RevenueCat Test Store key, starts with test_. DEVELOPMENT ONLY — used when the
# app runs against the Vite dev server. A production build refuses to configure
# with a test_ key, because RevenueCat forbids submitting one to Play.
VITE_REVENUECAT_TEST_KEY=
# The entitlement IDENTIFIER from the RevenueCat dashboard — the short id, not
# the display name ("Cocktail Flashcards Pro"). Must match REVENUECAT_ENTITLEMENT
# above, which the webhook uses.
VITE_REVENUECAT_ENTITLEMENT=cocktail_flashcards_pro

